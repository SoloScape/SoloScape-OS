    "start:public": "node scripts/run-public-original.mjs",
    "dev:original-engine:lan": "node scripts/run-original-lan.mjs",
    "mcp:original-engine": "node dev-bridge/stdio.mjs",
    "dev:desktop-controller": "node dev-bridge/controller-cli.mjs serve",
