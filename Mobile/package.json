    "probe:asset": "node gateway/js5-asset-cli.mjs",
    "dev:native": "node --watch browser/dev-server.mjs",
    "dev:lan": "node scripts/run-lan.mjs",
    "dev:tsps": "node scripts/run-client.mjs dev"
