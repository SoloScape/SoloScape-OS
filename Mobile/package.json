{
  "name": "@soloscape/mobile-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node browser/dev-server.mjs",
    "build:teavm": "node scripts/build-teavm.mjs",
    "test:teavm": "node teavm-poc/scripts/verify.mjs",
    "build": "node scripts/run-client.mjs build",
