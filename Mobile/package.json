{
  "name": "@soloscape/mobile-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --watch browser/dev-server.mjs",
